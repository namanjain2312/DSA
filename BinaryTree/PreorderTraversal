/**
 * Definition for a binary tree node.
 * struct TreeNode {
 *     int val;
 *     TreeNode *left;
 *     TreeNode *right;
 *     TreeNode() : val(0), left(nullptr), right(nullptr) {}
 *     TreeNode(int x) : val(x), left(nullptr), right(nullptr) {}
 *     TreeNode(int x, TreeNode *left, TreeNode *right) : val(x), left(left), right(right) {}
 * };
 */
 //Last Attempted On 26 Feb 2025
 //Attempted by recursion
 //Need to be attempt by using Stack as well , as stack is more optmized
 //as in recursion we need to do function call which takes a little more time
 //plus recursion stack stores two variable which has a little more more
 //complexity than normal


class Solution {
public:

    void preorderTraverse(TreeNode* node,vector<int> &output)
    {
        if(node==nullptr)
            return ;
        output.push_back(node->val);
        preorderTraverse(node->left,output);
        preorderTraverse(node->right,output);
    }
    vector<int> preorderTraversal(TreeNode* root) {
        vector<int>output;
        preorderTraverse(root,output);
        return output;
    }
};